  <script>
  function toggleSection(button) {
    const li = button.closest('.nav-section');
    const submenu = li.querySelector('.nav-submenu');
    const icon = button.querySelector('.toggle-icon');
    
    // Toggle current section
    const isOpen = li.classList.contains('open');
    li.classList.toggle('open');
    
    // Save state to localStorage
    const sectionName = button.querySelector('.nav-label').textContent;
    localStorage.setItem('sidebar-section-' + sectionName, isOpen ? 'closed' : 'open');
  }

  // Restore section states from localStorage on page load
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.nav-section').forEach(section => {
      const button = section.querySelector('.nav-section-toggle');
      const sectionName = button.querySelector('.nav-label').textContent;
      const savedState = localStorage.getItem('sidebar-section-' + sectionName);
      
      // Default to open for sections with active items
      const hasActive = section.querySelector('.nav-link.active');
      const shouldBeOpen = savedState === 'open' || (savedState === null && hasActive);
      
      if (shouldBeOpen) {
        section.classList.add('open');
      }
    });
  });
  </script>

