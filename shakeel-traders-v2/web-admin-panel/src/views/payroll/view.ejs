<div class="page-header">
  <div>
    <h4>Payroll Details - <%= payroll.staff_name %></h4>
    <div class="page-sub">
      <%= new Date(2000, payroll.month-1, 1).toLocaleString('default', { month: 'long' }) %> <%= payroll.year %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/payroll?month=<%= payroll.month %>&year=<%= payroll.year %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Back to Payroll
    </a>
  </div>
</div>

<!-- Staff Info Card -->
<div class="card mb-3">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h5 class="mb-3"><%= payroll.staff_name %></h5>
        <div class="row g-2">
          <div class="col-6">
            <div class="text-muted small">Staff Type</div>
            <div>
              <span class="badge badge-blue" style="text-transform:capitalize;">
                <%= payroll.staff_type.replace(/_/g, ' ') %>
              </span>
            </div>
          </div>
          <div class="col-6">
            <div class="text-muted small">Month / Year</div>
            <div class="fw-semibold">
              <%= new Date(2000, payroll.month-1, 1).toLocaleString('default', { month: 'long' }) %> <%= payroll.year %>
            </div>
          </div>
          <div class="col-6">
            <div class="text-muted small">Payment Status</div>
            <div>
              <% if (payroll.payment_status === 'paid') { %>
                <span class="badge bg-success">Paid</span>
              <% } else { %>
                <span class="badge bg-warning">Pending</span>
              <% } %>
            </div>
          </div>
          <div class="col-6">
            <div class="text-muted small">Generated On</div>
            <div class="small"><%= new Date(payroll.generated_at).toLocaleString() %></div>
          </div>
        </div>
      </div>
      <div class="col-md-6 text-end">
        <div class="text-muted small mb-2">Final Payable Amount</div>
        <div class="display-6 fw-bold" style="color:var(--primary);">
          Rs <%= parseFloat(payroll.final_payable).toLocaleString() %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Salary Breakdown -->
<div class="row mb-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <span style="font-weight:700;">Salary Calculation</span>
      </div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <td class="text-muted">Base Salary</td>
              <td class="text-end"><strong>Rs <%= parseFloat(payroll.base_salary).toLocaleString() %></strong></td>
            </tr>
            <tr class="table-light">
              <td class="text-muted">
                <div>Total Days in Month</div>
                <div class="small">
                  <span class="badge bg-secondary"><%= new Date(payroll.year, payroll.month, 0).getDate() %> days</span>
                </div>
              </td>
              <td></td>
            </tr>
            <tr>
              <td class="text-muted">
                <div>Less: Off Days (Fridays)</div>
                <div class="small text-primary"><%= payroll.off_days %> days</div>
              </td>
              <td></td>
            </tr>
            <tr>
              <td class="text-muted">
                <div>Less: Holidays</div>
                <div class="small text-warning"><%= payroll.holiday_days %> days</div>
              </td>
              <td></td>
            </tr>
            <tr class="table-light">
              <td class="text-muted"><strong>Working Days</strong></td>
              <td class="text-end"><strong><%= payroll.working_days %> days</strong></td>
            </tr>
            <tr>
              <td class="text-muted">Per Day Salary</td>
              <td class="text-end">Rs <%= parseFloat(payroll.per_day_salary).toLocaleString() %></td>
            </tr>
            <tr class="border-top">
              <td class="text-danger">
                <div>Absent Days</div>
                <div class="small"><%= payroll.absent_days %> days × Rs <%= parseFloat(payroll.per_day_salary).toLocaleString() %></div>
              </td>
              <td class="text-end text-danger">
                <strong>- Rs <%= parseFloat(payroll.absence_deduction).toLocaleString() %></strong>
              </td>
            </tr>
            <tr class="table-success">
              <td class="fw-bold">Net Salary</td>
              <td class="text-end fw-bold">Rs <%= parseFloat(payroll.net_salary).toLocaleString() %></td>
            </tr>
            <tr>
              <td class="text-warning">
                <div>Less: Advances Paid</div>
                <div class="small">During <%= new Date(2000, payroll.month-1, 1).toLocaleString('default', { month: 'long' }) %></div>
              </td>
              <td class="text-end text-warning">
                <strong>- Rs <%= parseFloat(payroll.advances_paid).toLocaleString() %></strong>
              </td>
            </tr>
            <tr class="table-primary border-top">
              <td><strong style="font-size:1.1rem;">Final Payable</strong></td>
              <td class="text-end"><strong style="font-size:1.2rem;color:var(--primary);">Rs <%= parseFloat(payroll.final_payable).toLocaleString() %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <span style="font-weight:700;">Attendance Summary</span>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-6">
            <div class="card border-success">
              <div class="card-body text-center">
                <i class="bi bi-check-circle text-success" style="font-size:2rem;"></i>
                <div class="mt-2">
                  <div class="h3 mb-0 text-success"><%= payroll.present_days %></div>
                  <div class="small text-muted">Present Days</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="card border-danger">
              <div class="card-body text-center">
                <i class="bi bi-x-circle text-danger" style="font-size:2rem;"></i>
                <div class="mt-2">
                  <div class="h3 mb-0 text-danger"><%= payroll.absent_days %></div>
                  <div class="small text-muted">Absent Days</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="card border-primary">
              <div class="card-body text-center">
                <i class="bi bi-calendar-x text-primary" style="font-size:2rem;"></i>
                <div class="mt-2">
                  <div class="h3 mb-0 text-primary"><%= payroll.off_days %></div>
                  <div class="small text-muted">Off Days (Friday)</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="card border-warning">
              <div class="card-body text-center">
                <i class="bi bi-calendar-event text-warning" style="font-size:2rem;"></i>
                <div class="mt-2">
                  <div class="h3 mb-0 text-warning"><%= payroll.holiday_days %></div>
                  <div class="small text-muted">Holidays</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-3 text-center">
          <a href="/attendance/staff/<%= payroll.staff_id %>/<%= payroll.staff_type %>?month=<%= payroll.month %>&year=<%= payroll.year %>" 
             class="btn btn-sm btn-outline-primary">
            <i class="bi bi-calendar-check me-1"></i> View Full Attendance
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Payment Section -->
<% if (payroll.payment_status === 'pending') { %>
  <!-- Payment Form -->
  <div class="card border-warning">
    <div class="card-header bg-warning bg-opacity-10">
      <span style="font-weight:700;"><i class="bi bi-exclamation-triangle me-2"></i>Payment Pending</span>
    </div>
    <div class="card-body">
      <form method="POST" action="/payroll/<%= payroll.id %>/pay" 
            onsubmit="return confirm('Mark this payroll as paid? Amount: Rs <%= parseFloat(payroll.final_payable).toLocaleString() %>')">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Payment Method <span class="text-danger">*</span></label>
            <select name="payment_method" class="form-select" required>
              <option value="">Select method...</option>
              <option value="cash">Cash</option>
              <option value="bank_transfer">Bank Transfer</option>
            </select>
          </div>
          <div class="col-md-8">
            <label class="form-label">Payment Note (Optional)</label>
            <input type="text" name="payment_note" class="form-control" 
                   placeholder="e.g., Transaction ID, Receipt Number, etc.">
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-success">
              <i class="bi bi-check-circle me-1"></i> Mark as Paid (Rs <%= parseFloat(payroll.final_payable).toLocaleString() %>)
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
<% } else { %>
  <!-- Payment Info -->
  <div class="card border-success">
    <div class="card-header bg-success bg-opacity-10">
      <span style="font-weight:700;"><i class="bi bi-check-circle me-2"></i>Payment Completed</span>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <div class="text-muted small">Payment Date</div>
          <div class="fw-semibold"><%= new Date(payroll.paid_at).toLocaleString() %></div>
        </div>
        <div class="col-md-3">
          <div class="text-muted small">Payment Method</div>
          <div>
            <span class="badge bg-success" style="text-transform:capitalize;">
              <%= payroll.payment_method.replace(/_/g, ' ') %>
            </span>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-muted small">Amount Paid</div>
          <div class="fw-bold text-success">Rs <%= parseFloat(payroll.final_payable).toLocaleString() %></div>
        </div>
        <div class="col-md-3">
          <div class="text-muted small">Payment Note</div>
          <div class="small"><%= payroll.payment_note || '—' %></div>
        </div>
      </div>
    </div>
  </div>
<% } %>
