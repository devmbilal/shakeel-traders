<div class="page-header">
  <div>
    <h4><%= staffName %> - Attendance History</h4>
    <div class="page-sub">
      <%= new Date(2000, month-1, 1).toLocaleString('default', { month: 'long' }) %> <%= year %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/attendance/report?month=<%= month %>&year=<%= year %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Back to Report
    </a>
  </div>
</div>

<!-- Month Selector -->
<div class="card mb-3">
  <div class="card-body py-2 px-3">
    <form method="GET" action="/attendance/staff/<%= staffId %>/<%= staffType %>" class="row g-2 align-items-center">
      <div class="col-auto">
        <label class="form-label mb-0 fw-semibold">Select Month:</label>
      </div>
      <div class="col-auto">
        <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= month == m ? 'selected' : '' %>>
              <%= new Date(2000, m-1, 1).toLocaleString('default', { month: 'long' }) %>
            </option>
          <% } %>
        </select>
      </div>
      <div class="col-auto">
        <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
          <% for (let y = year - 2; y <= year + 1; y++) { %>
            <option value="<%= y %>" <%= year == y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
      </div>
    </form>
  </div>
</div>

<!-- Summary Cards -->
<div class="row mb-3">
  <div class="col-md-2">
    <div class="card">
      <div class="card-body text-center">
        <div class="text-muted small mb-1">Total Days</div>
        <div class="h4 mb-0"><%= summary.total_days || 0 %></div>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-success">
      <div class="card-body text-center">
        <div class="text-success small mb-1">Present</div>
        <div class="h4 mb-0 text-success"><%= summary.present_days || 0 %></div>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-danger">
      <div class="card-body text-center">
        <div class="text-danger small mb-1">Absent</div>
        <div class="h4 mb-0 text-danger"><%= summary.absent_days || 0 %></div>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-primary">
      <div class="card-body text-center">
        <div class="text-primary small mb-1">Off Days</div>
        <div class="h4 mb-0 text-primary"><%= summary.off_days || 0 %></div>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-warning">
      <div class="card-body text-center">
        <div class="text-warning small mb-1">Holidays</div>
        <div class="h4 mb-0 text-warning"><%= summary.holiday_days || 0 %></div>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card bg-light">
      <div class="card-body text-center">
        <div class="text-muted small mb-1">Attendance %</div>
        <div class="h4 mb-0">
          <% 
            const totalDays = summary.total_days || 0;
            const workingDays = totalDays - (summary.off_days || 0) - (summary.holiday_days || 0);
            const presentDays = summary.present_days || 0;
            const attendancePercentage = workingDays > 0 
              ? ((presentDays / workingDays) * 100).toFixed(1)
              : 0;
          %>
          <%= attendancePercentage %>%
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Daily Attendance Table -->
<div class="card">
  <div class="card-header">
    <span style="font-weight:700;">Daily Attendance Records</span>
  </div>
  
  <div class="card-body p-0">
    <% if (attendance.length === 0) { %>
      <div style="text-align:center;padding:48px;color:var(--text-muted);">
        <i class="bi bi-calendar-x" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
        No attendance records found for this month.
      </div>
    <% } else { %>
      <table class="table mb-0">
        <thead>
          <tr>
            <th style="padding-left:20px;">Date</th>
            <th>Day</th>
            <th>Status</th>
            <th>Note</th>
            <th>Marked By</th>
          </tr>
        </thead>
        <tbody>
          <% attendance.forEach(a => { 
            const date = new Date(a.attendance_date);
            const dayName = date.toLocaleString('default', { weekday: 'long' });
          %>
          <tr>
            <td style="padding-left:20px;">
              <strong><%= sqlDateToDisplay(a.attendance_date) %></strong>
            </td>
            <td>
              <span class="badge <%= dayName === 'Friday' ? 'bg-primary' : 'bg-secondary' %>">
                <%= dayName %>
              </span>
            </td>
            <td>
              <% if (a.status === 'present') { %>
                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Present</span>
              <% } else if (a.status === 'absent') { %>
                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Absent</span>
              <% } else if (a.status === 'off') { %>
                <span class="badge bg-primary"><i class="bi bi-calendar-x me-1"></i> Off</span>
              <% } else if (a.status === 'holiday') { %>
                <span class="badge bg-warning"><i class="bi bi-calendar-event me-1"></i> Holiday</span>
              <% } %>
            </td>
            <td>
              <%= a.note || '—' %>
            </td>
            <td>
              <span class="text-muted small">
                <%= a.marked_by ? 'Admin' : 'System' %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
