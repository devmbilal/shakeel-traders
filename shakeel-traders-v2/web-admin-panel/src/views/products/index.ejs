<div class="page-header">
  <div>
    <h4>Product Management</h4>
    <div class="page-sub">Manage your product catalogue. SKU codes are unique identifiers.</div>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importProductsModal">
      <i class="bi bi-upload me-1"></i> Import CSV
    </button>
    <a href="/products/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-lg me-1"></i> Add Product
    </a>
  </div>
</div>

<!-- Filter bar -->
<div class="card mb-3">
  <div class="card-body py-2 px-3">
    <div class="d-flex gap-2 align-items-center flex-wrap">
      <span style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);">Filter:</span>
      <a href="/products" class="btn btn-sm <%= filter === '' ? 'btn-dark-primary' : 'btn-outline-secondary' %>">All</a>
      <a href="/products?filter=active" class="btn btn-sm <%= filter === 'active' ? 'btn-dark-primary' : 'btn-outline-secondary' %>">Active</a>
      <a href="/products?filter=inactive" class="btn btn-sm <%= filter === 'inactive' ? 'btn-dark-primary' : 'btn-outline-secondary' %>">Inactive</a>
      <a href="/products?filter=low_stock" class="btn btn-sm <%= filter === 'low_stock' ? 'btn-dark-primary' : 'btn-outline-secondary' %>">
        <i class="bi bi-exclamation-triangle me-1"></i>Low Stock
      </a>
      <span class="ms-auto" style="font-size:0.78rem;color:var(--text-muted);"><%= products.length %> products</span>
    </div>
  </div>
</div>

<!-- Search Bar -->
<div class="card mb-3">
  <div class="card-body py-2 px-3">
    <div class="d-flex gap-2 align-items-center">
      <i class="bi bi-search" style="color:var(--text-secondary);"></i>
      <input type="text" id="productSearch" class="form-control form-control-sm border-0" placeholder="Search by SKU, product name, or brand..." style="box-shadow:none;">
    </div>
  </div>
</div>

<% if (pagination && pagination.total > 0) { %>
  <p class="text-muted small mb-2"><%= pagination.total %> records</p>
<% } %>

<div class="card table-card">
  <% if (products.length === 0) { %>
    <div style="text-align:center;padding:48px;color:var(--text-muted);">
      <i class="bi bi-box" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
      No products found. <a href="/products/new">Add your first product</a>.
    </div>
  <% } else { %>
  <table class="table" id="productTable">
    <thead>
      <tr>
        <th>SKU</th>
        <th>Product Name</th>
        <th>Brand</th>
        <th>Units/Carton</th>
        <th>Stock</th>
        <th>Retail Price</th>
        <th>Wholesale</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(p => { %>
      <tr>
        <td><code style="font-size:0.78rem;background:#F1F5F9;padding:2px 6px;border-radius:4px;"><%= p.sku_code %></code></td>
        <td><span style="font-weight:600;"><%= p.name %></span></td>
        <td><span style="color:var(--text-secondary);"><%= p.brand || '—' %></span></td>
        <td><%= p.units_per_carton %></td>
        <td>
          <% const totalUnits = p.current_stock_cartons * p.units_per_carton + p.current_stock_loose; %>
          <% const isLow = p.low_stock_threshold && totalUnits <= p.low_stock_threshold; %>
          <span style="font-weight:600;color:<%= isLow ? '#EF4444' : 'var(--text-primary)' %>;">
            <%= p.current_stock_cartons %>C + <%= p.current_stock_loose %>L
          </span>
          <% if (isLow) { %><i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Low stock"></i><% } %>
        </td>
        <td>Rs <%= Number(p.retail_price).toFixed(2) %></td>
        <td>Rs <%= Number(p.wholesale_price).toFixed(2) %></td>
        <td>
          <% if (p.is_active) { %>
            <span class="badge badge-active">Active</span>
          <% } else { %>
            <span class="badge badge-inactive">Inactive</span>
          <% } %>
        </td>
        <td>
          <div class="d-flex gap-1 action-buttons">
            <a href="/products/<%= p.id %>/edit" class="btn btn-icon btn-edit" title="Edit">
              <i class="bi bi-pencil"></i>
            </a>
            <a href="/products/<%= p.id %>/movements" class="btn btn-icon btn-outline-secondary" title="Stock History">
              <i class="bi bi-clock-history"></i>
            </a>
            
            <!-- Quick Actions Dropdown -->
            <div class="btn-group">
              <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" title="Quick Actions">
                <i class="bi bi-lightning-charge"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">Quick Actions</h6></li>
                <li>
                  <a class="dropdown-item" href="javascript:void(0)" onclick="showQuickPriceUpdate(<%= p.id %>, <%= p.retail_price %>, <%= p.wholesale_price %>)">
                    <i class="bi bi-cash text-primary me-2"></i> Update Prices
                  </a>
                </li>
                <li>
                  <a class="dropdown-item" href="javascript:void(0)" onclick="showQuickThresholdUpdate(<%= p.id %>, <%= p.low_stock_threshold || 'null' %>)">
                    <i class="bi bi-speedometer2 text-warning me-2"></i> Set Low Stock Alert
                  </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <% if (p.is_active) { %>
                  <li>
                    <form method="POST" action="/products/<%= p.id %>/deactivate" class="d-inline"
                          onsubmit="return confirm('Deactivate <%= p.name %>?')">
                      <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-slash-circle me-2"></i> Deactivate Product
                      </button>
                    </form>
                  </li>
                <% } else { %>
                  <li>
                    <form method="POST" action="/products/<%= p.id %>/activate" class="d-inline">
                      <button type="submit" class="dropdown-item text-success">
                        <i class="bi bi-check-circle me-2"></i> Reactivate Product
                      </button>
                    </form>
                  </li>
                <% } %>
              </ul>
            </div>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<%- include('../layout/pagination', {pagination, queryString}) %>

<!-- Quick Price Update Modal -->
<div class="modal fade" id="quickPriceModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Update Prices</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="priceProductId">
        <div class="mb-3">
          <label class="form-label">Retail Price (Rs)</label>
          <input type="number" id="quickRetailPrice" class="form-control" min="0" step="0.01" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Wholesale Price (Rs)</label>
          <input type="number" id="quickWholesalePrice" class="form-control" min="0" step="0.01" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyQuickPriceUpdate()">
          <i class="bi bi-check-lg me-1"></i> Update
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Quick Threshold Update Modal -->
<div class="modal fade" id="quickThresholdModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Set Low Stock Alert</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="thresholdProductId">
        <div class="mb-3">
          <label class="form-label">Low Stock Threshold (units)</label>
          <input type="number" id="quickThreshold" class="form-control" min="0" step="1" placeholder="Leave empty to disable">
          <div class="form-text">Alert when total stock (cartons + loose) falls to or below this value</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyQuickThresholdUpdate()">
          <i class="bi bi-check-lg me-1"></i> Update
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Import Products Modal -->
<div class="modal fade" id="importProductsModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-upload me-2"></i>Import Products via CSV</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/products/import" enctype="multipart/form-data">
        <div class="modal-body">

          <div class="alert alert-info" style="font-size:0.82rem;">
            <i class="bi bi-info-circle me-1"></i>
            If a SKU already exists, the product will be <strong>updated</strong> (stock is never changed by import).
            New SKUs will be <strong>created</strong>.
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">CSV File <span class="text-danger">*</span></label>
            <input type="file" name="csv_file" class="form-control" accept=".csv" required>
            <div class="form-text">Max 5 MB. UTF-8 encoded.</div>
          </div>

          <div class="card" style="background:#F8FAFC;">
            <div class="card-body py-2 px-3">
              <div class="small fw-semibold mb-2">Required CSV columns (header row must match exactly):</div>
              <table class="table table-sm mb-2" style="font-size:0.78rem;">
                <thead><tr><th>Column</th><th>Required</th><th>Example</th></tr></thead>
                <tbody>
                  <tr><td><code>sku_code</code></td><td><span class="badge badge-rejected">Required</span></td><td>CBL-001</td></tr>
                  <tr><td><code>name</code></td><td><span class="badge badge-rejected">Required</span></td><td>Sooper Biscuit</td></tr>
                  <tr><td><code>units_per_carton</code></td><td><span class="badge badge-rejected">Required</span></td><td>12</td></tr>
                  <tr><td><code>retail_price</code></td><td><span class="badge badge-rejected">Required</span></td><td>850.00</td></tr>
                  <tr><td><code>wholesale_price</code></td><td><span class="badge badge-rejected">Required</span></td><td>800.00</td></tr>
                  <tr><td><code>brand</code></td><td><span class="badge badge-inactive">Optional</span></td><td>CBL</td></tr>
                  <tr><td><code>low_stock_threshold</code></td><td><span class="badge badge-inactive">Optional</span></td><td>10</td></tr>
                </tbody>
              </table>
              <div class="small text-muted">Sample row:</div>
              <code style="font-size:0.72rem;word-break:break-all;">sku_code,name,brand,units_per_carton,retail_price,wholesale_price,low_stock_threshold<br>CBL-001,Sooper Biscuit,CBL,12,850.00,800.00,10</code>
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-upload me-1"></i> Import</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Product search functionality
document.getElementById('productSearch').addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const rows = document.querySelectorAll('#productTable tbody tr');
  
  rows.forEach(row => {
    const sku = row.cells[0].textContent.toLowerCase();
    const product = row.cells[1].textContent.toLowerCase();
    const brand = row.cells[2].textContent.toLowerCase();
    
    if (sku.includes(searchTerm) || product.includes(searchTerm) || brand.includes(searchTerm)) {
      row.style.display = '';
      // Show action buttons when row is visible
      const actionButtons = row.querySelector('.action-buttons');
      if (actionButtons) actionButtons.style.display = 'flex';
    } else {
      row.style.display = 'none';
    }
  });
});

// Quick price update
function showQuickPriceUpdate(productId, retailPrice, wholesalePrice) {
  document.getElementById('priceProductId').value = productId;
  document.getElementById('quickRetailPrice').value = parseFloat(retailPrice).toFixed(2);
  document.getElementById('quickWholesalePrice').value = parseFloat(wholesalePrice).toFixed(2);
  const modal = new bootstrap.Modal(document.getElementById('quickPriceModal'));
  modal.show();
  setTimeout(() => document.getElementById('quickRetailPrice').focus(), 300);
}

function applyQuickPriceUpdate() {
  const productId = document.getElementById('priceProductId').value;
  const retailPrice = parseFloat(document.getElementById('quickRetailPrice').value);
  const wholesalePrice = parseFloat(document.getElementById('quickWholesalePrice').value);
  
  if (isNaN(retailPrice) || retailPrice < 0) {
    alert('Please enter a valid retail price');
    return;
  }
  if (isNaN(wholesalePrice) || wholesalePrice < 0) {
    alert('Please enter a valid wholesale price');
    return;
  }
  
  const modal = bootstrap.Modal.getInstance(document.getElementById('quickPriceModal'));
  modal.hide();
  
  fetch(`/products/${productId}/quick-price-update`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ retail_price: retailPrice, wholesale_price: wholesalePrice })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      window.location.reload();
    } else {
      alert('Failed: ' + (data.message || 'Unknown error'));
    }
  })
  .catch(err => alert('Error: ' + err.message));
}

// Quick threshold update
function showQuickThresholdUpdate(productId, currentThreshold) {
  document.getElementById('thresholdProductId').value = productId;
  document.getElementById('quickThreshold').value = currentThreshold !== null ? currentThreshold : '';
  const modal = new bootstrap.Modal(document.getElementById('quickThresholdModal'));
  modal.show();
  setTimeout(() => document.getElementById('quickThreshold').focus(), 300);
}

function applyQuickThresholdUpdate() {
  const productId = document.getElementById('thresholdProductId').value;
  const thresholdInput = document.getElementById('quickThreshold').value.trim();
  const threshold = thresholdInput === '' ? null : parseFloat(thresholdInput);
  
  if (threshold !== null && (isNaN(threshold) || threshold < 0)) {
    alert('Please enter a valid threshold value');
    return;
  }
  
  const modal = bootstrap.Modal.getInstance(document.getElementById('quickThresholdModal'));
  modal.hide();
  
  fetch(`/products/${productId}/quick-threshold-update`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ low_stock_threshold: threshold })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      window.location.reload();
    } else {
      alert('Failed: ' + (data.message || 'Unknown error'));
    }
  })
  .catch(err => alert('Error: ' + err.message));
}

// Allow Enter key in modals
document.addEventListener('DOMContentLoaded', function() {
  const retailInput = document.getElementById('quickRetailPrice');
  const wholesaleInput = document.getElementById('quickWholesalePrice');
  const thresholdInput = document.getElementById('quickThreshold');
  
  if (retailInput) {
    retailInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        wholesaleInput.focus();
      }
    });
  }
  
  if (wholesaleInput) {
    wholesaleInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        applyQuickPriceUpdate();
      }
    });
  }
  
  if (thresholdInput) {
    thresholdInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        applyQuickThresholdUpdate();
      }
    });
  }
});
</script>
