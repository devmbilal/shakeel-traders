<div class="page-header">
  <div>
    <h4>Manage Holidays</h4>
    <div class="page-sub">Mark system-wide holidays for all staff members</div>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
      <i class="bi bi-plus-lg me-1"></i> Add Holiday
    </button>
  </div>
</div>

<!-- Year Selector -->
<div class="card mb-3">
  <div class="card-body py-2 px-3">
    <form method="GET" action="/holidays" class="row g-2 align-items-center">
      <div class="col-auto">
        <label class="form-label mb-0 fw-semibold">Select Year:</label>
      </div>
      <div class="col-auto">
        <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
          <% for (let y = selectedYear - 2; y <= selectedYear + 2; y++) { %>
            <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
      </div>
      <div class="col-auto ms-auto">
        <span class="badge bg-primary"><%= holidays.length %> Holidays</span>
      </div>
    </form>
  </div>
</div>

<!-- Holidays List -->
<div class="card">
  <div class="card-header">
    <span style="font-weight:700;">Holidays in <%= selectedYear %></span>
  </div>
  
  <div class="card-body p-0">
    <% if (holidays.length === 0) { %>
      <div style="text-align:center;padding:48px;color:var(--text-muted);">
        <i class="bi bi-calendar-event" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
        No holidays marked for <%= selectedYear %>. <a href="#" data-bs-toggle="modal" data-bs-target="#addHolidayModal">Add your first holiday</a>.
      </div>
    <% } else { %>
      <table class="table mb-0">
        <thead>
          <tr>
            <th style="padding-left:20px;">Date</th>
            <th>Day</th>
            <th>Holiday Name</th>
            <th>Description</th>
            <th>Created By</th>
            <th style="width:150px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% holidays.forEach(h => { 
            const date = new Date(h.holiday_date);
            const dayName = date.toLocaleString('default', { weekday: 'long' });
            const isUpcoming = new Date(h.holiday_date) > new Date();
            const isPast = new Date(h.holiday_date) < new Date();
            const isToday = new Date(h.holiday_date).toDateString() === new Date().toDateString();
          %>
          <tr <%= isUpcoming ? 'class="table-success"' : '' %> <%= isToday ? 'class="table-warning"' : '' %>>
            <td style="padding-left:20px;">
              <strong><%= new Date(h.holiday_date).toLocaleDateString() %></strong>
              <% if (isToday) { %>
                <span class="badge bg-warning ms-2">Today</span>
              <% } else if (isUpcoming) { %>
                <span class="badge bg-success ms-2">Upcoming</span>
              <% } %>
            </td>
            <td>
              <span class="badge bg-secondary"><%= dayName %></span>
            </td>
            <td>
              <div style="font-weight:600;"><%= h.name %></div>
            </td>
            <td>
              <span class="text-muted"><%= h.description || '—' %></span>
            </td>
            <td>
              <span class="text-muted small"><%= h.created_by_name %></span>
            </td>
            <td>
              <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-primary btn-icon" 
                        data-bs-toggle="modal" 
                        data-bs-target="#editHolidayModal<%= h.id %>"
                        title="Edit">
                  <i class="bi bi-pencil"></i>
                </button>
                <form method="POST" action="/holidays/<%= h.id %>/delete" class="d-inline"
                      onsubmit="return confirm('Delete holiday &quot;<%= h.name %>&quot;?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          
          <!-- Edit Modal for each holiday -->
          <div class="modal fade" id="editHolidayModal<%= h.id %>" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h6 class="modal-title">Edit Holiday</h6>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="POST" action="/holidays/<%= h.id %>/update">
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Date</label>
                      <input type="text" class="form-control" value="<%= h.holiday_date %>" disabled>
                      <div class="form-text">Date cannot be changed. Delete and create new holiday if needed.</div>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Holiday Name <span class="text-danger">*</span></label>
                      <input type="text" name="name" class="form-control" value="<%= h.name %>" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Description</label>
                      <textarea name="description" class="form-control" rows="2"><%= h.description || '' %></textarea>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                      <i class="bi bi-save me-1"></i> Update Holiday
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- Add Holiday Modal -->
<div class="modal fade" id="addHolidayModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Add New Holiday</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/holidays">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Holiday Date <span class="text-danger">*</span></label>
            <input type="date" name="holiday_date" class="form-control" required>
            <div class="form-text">This date will be marked as holiday for all staff members</div>
          </div>
          <div class="mb-3">
            <label class="form-label">Holiday Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="e.g., Independence Day" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description (Optional)</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Additional details about this holiday"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Holiday
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Info Card -->
<div class="card mt-3 border-info">
  <div class="card-body">
    <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>About Holidays</h6>
    <ul class="mb-0 small">
      <li><strong>System-wide:</strong> Holidays apply to all staff members automatically</li>
      <li><strong>Attendance:</strong> When marking attendance, holidays will show as "Holiday" status</li>
      <li><strong>Payroll:</strong> Holiday days are NOT counted as working days and NOT deducted from salary</li>
      <li><strong>Friday:</strong> Fridays are automatically marked as weekly off (no need to add as holiday)</li>
    </ul>
  </div>
</div>
