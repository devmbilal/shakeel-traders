<div class="page-header">
  <div><h4>Stock Management</h4><div class="page-sub">Warehouse stock overview and movement management</div></div>
  <div class="d-flex gap-2">
    <a href="/stock/manual-add" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg me-1"></i> Manual Add</a>
    <a href="/stock/add-from-supplier" class="btn btn-primary btn-sm"><i class="bi bi-truck me-1"></i> Add from Supplier</a>
  </div>
</div>

<!-- Quick nav tabs -->
<div class="d-flex gap-2 mb-3 flex-wrap">
  <a href="/stock" class="btn btn-dark-primary btn-sm">Stock Overview</a>
  <a href="/stock/pending-issuances" class="btn btn-outline-secondary btn-sm">Pending Issuances</a>
  <a href="/stock/pending-returns" class="btn btn-outline-secondary btn-sm">Pending Returns</a>
  <a href="/stock/requirement-report" class="btn btn-outline-secondary btn-sm">Requirement Report</a>
</div>

<!-- Search Bar -->
<div class="card mb-3">
  <div class="card-body py-2 px-3">
    <div class="d-flex gap-2 align-items-center">
      <i class="bi bi-search" style="color:var(--text-secondary);"></i>
      <input type="text" id="stockSearch" class="form-control form-control-sm border-0" placeholder="Search by SKU, product name, or brand..." style="box-shadow:none;">
    </div>
  </div>
</div>

<div class="card table-card">
  <% if (products.length === 0) { %>
    <div style="text-align:center;padding:48px;color:var(--text-muted);">No active products found.</div>
  <% } else { %>
  <table class="table" id="stockTable">
    <thead>
      <tr>
        <th>SKU</th><th>Product</th><th>Brand</th>
        <th>Cartons</th><th>Loose Units</th><th>Total Units</th>
        <th>Retail Price</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(p => { %>
      <% const totalUnits = p.current_stock_cartons * p.units_per_carton + p.current_stock_loose; %>
      <% const isLow = p.low_stock_threshold && totalUnits <= p.low_stock_threshold; %>
      <tr>
        <td><code style="font-size:0.75rem;background:#F1F5F9;padding:2px 6px;border-radius:4px;"><%= p.sku_code %></code></td>
        <td><span style="font-weight:600;"><%= p.name %></span></td>
        <td style="color:var(--text-secondary);"><%= p.brand || '—' %></td>
        <td style="font-weight:600;color:<%= isLow ? '#EF4444' : 'var(--text-primary)' %>;"><%= p.current_stock_cartons %></td>
        <td style="font-weight:600;color:<%= isLow ? '#EF4444' : 'var(--text-primary)' %>;"><%= p.current_stock_loose %></td>
        <td>
          <span style="font-weight:700;color:<%= isLow ? '#EF4444' : '#10B981' %>;">
            <%= totalUnits %>
            <% if (isLow) { %><i class="bi bi-exclamation-triangle-fill ms-1" title="Low stock"></i><% } %>
          </span>
        </td>
        <td>Rs <%= Number(p.retail_price).toFixed(2) %></td>
        <td>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="openStockModal(<%= p.id %>, '<%= p.name %>', <%= p.current_stock_cartons %>, <%= p.current_stock_loose %>, <%= p.units_per_carton %>)" title="Adjust Stock">
              <i class="bi bi-pencil-square"></i>
            </button>
            <a href="/stock/<%= p.id %>/movements" class="btn btn-sm btn-outline-secondary" title="Movement History">
              <i class="bi bi-clock-history"></i>
            </a>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<script>
// Stock search functionality
document.getElementById('stockSearch').addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const rows = document.querySelectorAll('#stockTable tbody tr');
  
  rows.forEach(row => {
    const sku = row.cells[0].textContent.toLowerCase();
    const product = row.cells[1].textContent.toLowerCase();
    const brand = row.cells[2].textContent.toLowerCase();
    
    if (sku.includes(searchTerm) || product.includes(searchTerm) || brand.includes(searchTerm)) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
});

// Open stock adjustment modal
function openStockModal(productId, productName, currentCartons, currentLoose, unitsPerCarton) {
  document.getElementById('modalProductName').textContent = productName;
  document.getElementById('modalCurrentStock').textContent = `Current: ${currentCartons}C + ${currentLoose}L`;
  document.getElementById('adjustProductId').value = productId;
  document.getElementById('adjustCartons').value = '';
  document.getElementById('adjustLoose').value = '';
  document.getElementById('adjustNote').value = '';
  document.getElementById('adjustAction').value = 'add';
  
  // Update button colors
  updateActionButtons('add');
  
  const modal = new bootstrap.Modal(document.getElementById('stockAdjustModal'));
  modal.show();
}

// Update action button styling
function updateActionButtons(action) {
  const addBtn = document.getElementById('actionAddBtn');
  const removeBtn = document.getElementById('actionRemoveBtn');
  
  if (action === 'add') {
    addBtn.classList.add('btn-success');
    addBtn.classList.remove('btn-outline-success');
    removeBtn.classList.add('btn-outline-danger');
    removeBtn.classList.remove('btn-danger');
  } else {
    removeBtn.classList.add('btn-danger');
    removeBtn.classList.remove('btn-outline-danger');
    addBtn.classList.add('btn-outline-success');
    addBtn.classList.remove('btn-success');
  }
  
  document.getElementById('adjustAction').value = action;
}
</script>

<!-- Stock Adjustment Modal -->
<div class="modal fade" id="stockAdjustModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Adjust Stock</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/stock/quick-adjust">
        <div class="modal-body">
          <div class="alert alert-info py-2 small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            <strong id="modalProductName"></strong><br>
            <span id="modalCurrentStock"></span>
          </div>
          
          <input type="hidden" id="adjustProductId" name="product_id">
          <input type="hidden" id="adjustAction" name="action" value="add">
          
          <div class="mb-3">
            <label class="form-label fw-semibold">Action</label>
            <div class="btn-group w-100" role="group">
              <button type="button" id="actionAddBtn" class="btn btn-success" onclick="updateActionButtons('add')">
                <i class="bi bi-plus-lg me-1"></i> Add Stock
              </button>
              <button type="button" id="actionRemoveBtn" class="btn btn-outline-danger" onclick="updateActionButtons('remove')">
                <i class="bi bi-dash-lg me-1"></i> Remove Stock
              </button>
            </div>
          </div>
          
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label">Cartons</label>
              <input type="number" id="adjustCartons" name="cartons" class="form-control" min="0" value="0" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Loose Units</label>
              <input type="number" id="adjustLoose" name="loose" class="form-control" min="0" value="0" required>
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Note (Optional)</label>
            <textarea id="adjustNote" name="note" class="form-control" rows="2" placeholder="Reason for adjustment..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Confirm Adjustment
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
