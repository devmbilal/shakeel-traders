<div class="page-header">
  <div>
    <h4>Shop Management</h4>
    <div class="page-sub">Manage all shops, routes, and outstanding balances</div>
  </div>
  <div class="d-flex gap-2">
    <a href="/shops/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Add Shop</a>
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">
      <i class="bi bi-upload me-1"></i> Import CSV
    </button>
  </div>
</div>

<!-- Filters -->
<div class="card mb-3">
  <div class="card-body" style="padding:14px 20px;">
    <form method="GET" action="/shops" class="row g-2 align-items-end">
      <div class="col-md-3">
        <input type="text" name="search" class="form-control" placeholder="Search name, owner, phone..." value="<%= filters.search %>">
      </div>
      <div class="col-md-2">
        <select name="route_id" class="form-select" data-searchable>
          <option value="">All Routes</option>
          <% routes.forEach(r => { %>
          <option value="<%= r.id %>" <%= filters.route_id == r.id ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <select name="shop_type" class="form-select">
          <option value="">All Types</option>
          <option value="retail" <%= filters.shop_type === 'retail' ? 'selected' : '' %>>Retail</option>
          <option value="wholesale" <%= filters.shop_type === 'wholesale' ? 'selected' : '' %>>Wholesale</option>
        </select>
      </div>
      <div class="col-md-2">
        <select name="is_active" class="form-select">
          <option value="">All Status</option>
          <option value="1" <%= filters.is_active === '1' ? 'selected' : '' %>>Active</option>
          <option value="0" <%= filters.is_active === '0' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <div class="col-md-2">
        <select name="has_outstanding" class="form-select">
          <option value="">All Balances</option>
          <option value="1" <%= filters.has_outstanding === '1' ? 'selected' : '' %>>Has Outstanding</option>
          <option value="0" <%= filters.has_outstanding === '0' ? 'selected' : '' %>>No Outstanding</option>
        </select>
      </div>
      <div class="col-auto d-flex gap-1">
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i> Filter</button>
        <a href="/shops" class="btn btn-outline-secondary btn-sm">Clear</a>
      </div>
      <div class="col-auto ms-auto" style="font-size:0.78rem;color:var(--text-muted);align-self:center;"><%= shops.length %> shops</div>
    </form>
  </div>
</div>

<% if (pagination && pagination.total > 0) { %>
  <p class="text-muted small mb-2"><%= pagination.total %> records</p>
<% } %>

<div class="card">
  <div class="card-body p-0">
    <% if (shops.length === 0) { %>
      <div style="text-align:center;padding:48px;color:var(--text-muted);">
        <i class="bi bi-shop-window" style="font-size:2.5rem;display:block;margin-bottom:10px;"></i>
        No shops found. <a href="/shops/new" style="color:var(--secondary);">Add your first shop</a>.
      </div>
    <% } else { %>
      <table class="table mb-0">
        <thead><tr>
          <th style="padding-left:20px;">Shop Name</th>
          <th>Route</th>
          <th>Type</th>
          <th>Price Edit</th>
          <th>Outstanding</th>
          <th>Status</th>
          <th style="width:200px;">Actions</th>
        </tr></thead>
        <tbody>
          <% shops.forEach(s => { const bal = parseFloat(s.outstanding_balance || 0); %>
          <tr>
            <td style="padding-left:20px;">
              <div style="font-weight:600;font-size:0.85rem;"><%= s.name %></div>
              <% if (s.owner_name) { %><div style="font-size:0.72rem;color:var(--text-muted);"><%= s.owner_name %></div><% } %>
            </td>
            <td><span class="badge badge-blue"><%= s.route_name || '—' %></span></td>
            <td><span class="badge badge-orange" style="text-transform:capitalize;"><%= s.shop_type %></span></td>
            <td>
              <% if (s.price_edit_allowed) { %>
                <div style="font-size:0.75rem;">
                  <span class="badge bg-success">Allowed</span>
                  <div class="text-muted mt-1">Max: <%= parseFloat(s.price_max_discount_pct || 0).toFixed(0) %>%</div>
                </div>
              <% } else { %>
                <span class="badge bg-secondary">Not Allowed</span>
              <% } %>
            </td>
            <td>
              <% if (bal > 0) { %>
                <span style="font-weight:700;color:#EF4444;font-family:'Manrope',sans-serif;">Rs <%= bal.toLocaleString() %></span>
              <% } else if (bal < 0) { %>
                <span style="font-weight:700;color:#10B981;font-family:'Manrope',sans-serif;">Adv Rs <%= Math.abs(bal).toLocaleString() %></span>
              <% } else { %>
                <span style="color:var(--text-muted);">—</span>
              <% } %>
            </td>
            <td><span class="badge <%= s.is_active ? 'badge-active' : 'badge-inactive' %>"><%= s.is_active ? 'Active' : 'Inactive' %></span></td>
            <td>
              <div class="d-flex gap-1">
                <a href="/shops/<%= s.id %>" class="btn btn-sm btn-edit btn-icon" title="Edit Shop"><i class="bi bi-pencil"></i></a>
                <a href="/shops/<%= s.id %>/ledger" class="btn btn-sm btn-assign btn-icon" title="View Ledger"><i class="bi bi-journal-text"></i></a>
                
                <!-- Quick Actions Dropdown -->
                <div class="btn-group">
                  <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" title="Quick Actions">
                    <i class="bi bi-lightning-charge"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header">Price Edit Permissions</h6></li>
                    <% if (!s.price_edit_allowed) { %>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 0)">
                          <i class="bi bi-check-circle text-success me-2"></i> Allow Price Edit (0% discount)
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 2)">
                          <i class="bi bi-check-circle text-success me-2"></i> Allow with 2% Discount
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 5)">
                          <i class="bi bi-check-circle text-success me-2"></i> Allow with 5% Discount
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 10)">
                          <i class="bi bi-check-circle text-success me-2"></i> Allow with 10% Discount
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 15)">
                          <i class="bi bi-check-circle text-success me-2"></i> Allow with 15% Discount
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="showCustomDiscount(<%= s.id %>)">
                          <i class="bi bi-input-cursor text-primary me-2"></i> Custom Discount %
                        </a>
                      </li>
                    <% } else { %>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 0, 0)">
                          <i class="bi bi-x-circle text-danger me-2"></i> Disallow Price Edit
                        </a>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li><h6 class="dropdown-header">Change Discount %</h6></li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 2)">
                          <i class="bi bi-arrow-repeat me-2"></i> Change to 2%
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 5)">
                          <i class="bi bi-arrow-repeat me-2"></i> Change to 5%
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 10)">
                          <i class="bi bi-arrow-repeat me-2"></i> Change to 10%
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="quickSetPriceEdit(<%= s.id %>, 1, 15)">
                          <i class="bi bi-arrow-repeat me-2"></i> Change to 15%
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="showCustomDiscount(<%= s.id %>)">
                          <i class="bi bi-input-cursor text-primary me-2"></i> Custom Discount %
                        </a>
                      </li>
                    <% } %>
                  </ul>
                </div>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('../layout/pagination', {pagination, queryString}) %>

<!-- Import CSV Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Import Shops from CSV</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/shops/import" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="alert alert-info" style="font-size:0.8rem;">
            <i class="bi bi-info-circle me-1"></i>
            CSV must have columns: <code>name, route_id, shop_type, owner_name, phone, address</code>
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-semibold">Route Filter (Optional)</label>
            <select name="route_filter" class="form-select form-select-sm">
              <option value="">— All routes (import entire CSV) —</option>
              <% routes.filter(r => r.is_active).forEach(route => { %>
                <option value="<%= route.id %>"><%= route.name %> (ID: <%= route.id %>)</option>
              <% }) %>
            </select>
            <div class="form-text">
              If selected, only shops with matching <code>route_id</code> in the CSV will be imported.
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-semibold">CSV File <span class="text-danger">*</span></label>
            <input type="file" name="csv_file" class="form-control" accept=".csv" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-upload me-1"></i> Import</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Custom Discount Modal -->
<div class="modal fade" id="customDiscountModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Set Custom Discount</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Max Discount Percentage</label>
          <div class="input-group">
            <input type="number" id="customDiscountInput" class="form-control" min="0" max="100" step="0.1" placeholder="e.g., 12.5">
            <span class="input-group-text">%</span>
          </div>
          <div class="form-text">Enter the maximum discount percentage allowed (0-100)</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="applyCustomDiscount()">
          <i class="bi bi-check-lg me-1"></i> Apply
        </button>
      </div>
    </div>
  </div>
</div>

<script>
let currentShopId = null;

// Quick set price edit permissions
function quickSetPriceEdit(shopId, allowed, discountPct) {
  const action = allowed ? 'allow' : 'disallow';
  const msg = allowed 
    ? `Allow price editing with ${discountPct}% max discount for this shop?`
    : `Disallow price editing for this shop?`;
  
  if (!confirm(msg)) return;
  
  // Show loading indicator
  const dropdown = event.target.closest('.dropdown-menu');
  if (dropdown) {
    dropdown.style.opacity = '0.5';
    dropdown.style.pointerEvents = 'none';
  }
  
  fetch(`/shops/${shopId}/quick-price-edit`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      price_edit_allowed: allowed,
      price_max_discount_pct: discountPct
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Reload page to show updated status
      window.location.reload();
    } else {
      alert('Failed to update: ' + (data.message || 'Unknown error'));
      if (dropdown) {
        dropdown.style.opacity = '1';
        dropdown.style.pointerEvents = 'auto';
      }
    }
  })
  .catch(err => {
    alert('Error: ' + err.message);
    if (dropdown) {
      dropdown.style.opacity = '1';
      dropdown.style.pointerEvents = 'auto';
    }
  });
}

// Show custom discount modal
function showCustomDiscount(shopId) {
  currentShopId = shopId;
  document.getElementById('customDiscountInput').value = '';
  const modal = new bootstrap.Modal(document.getElementById('customDiscountModal'));
  modal.show();
  setTimeout(() => document.getElementById('customDiscountInput').focus(), 300);
}

// Apply custom discount
function applyCustomDiscount() {
  const input = document.getElementById('customDiscountInput');
  const discountPct = parseFloat(input.value);
  
  if (isNaN(discountPct) || discountPct < 0 || discountPct > 100) {
    alert('Please enter a valid discount percentage between 0 and 100');
    input.focus();
    return;
  }
  
  const modal = bootstrap.Modal.getInstance(document.getElementById('customDiscountModal'));
  modal.hide();
  
  // Call the quick set function
  quickSetPriceEdit(currentShopId, 1, discountPct);
}

// Allow Enter key in custom discount modal
document.addEventListener('DOMContentLoaded', function() {
  const input = document.getElementById('customDiscountInput');
  if (input) {
    input.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        applyCustomDiscount();
      }
    });
  }
});
</script>
